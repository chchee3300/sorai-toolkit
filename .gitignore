# Developer tools' files
.lite_workspace.lua

# Node dependencies
/node_modules

# Claude Code local (machine-specific) settings
.claude/settings.local.json

# Vite build output (tauri.conf.json frontendDist)
/web-dist

# Third-party executables fetched by setup.mjs (ffmpeg, qpdf, etc.) — too large for GitHub
/binaries

# Release job output (release.yml "Collect release assets", scripts/updater-manifest.mjs)
/release-assets

# Regenerated fresh by packaging/linux/generate-context-menu-registry.mjs
# before every .deb/.rpm build -- never hand-edited, never stale in git.
/packaging/linux/context-menu.generated/

*.log

# Plugin links generated by scripts/siblings.mjs (machine-specific)
/.plugins
