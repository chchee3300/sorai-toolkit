{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SORAI Toolkit",
  "version": "0.1.0",
  "identifier": "com.soraitoolkit.hub",
  "build": {
    "frontendDist": "../web-dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "node scripts/copy-sidecars.mjs && node scripts/siblings.mjs && npm run dev",
    "beforeBuildCommand": "node scripts/copy-sidecars.mjs && node scripts/siblings.mjs && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "SORAI Toolkit",
        "width": 1060,
        "height": 700,
        "minWidth": 660,
        "minHeight": 460,
        "center": true,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "PLACEHOLDER-UPDATER-PUBKEY-FILLED-BY-TICKET-14",
      "endpoints": ["https://github.com/chchee3300/sorai-toolkit/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/ffmpeg", "binaries/yt-dlp"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
