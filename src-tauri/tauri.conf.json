{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SORAI Toolkit",
  "version": "2.0.0",
  "identifier": "com.soraitoolkit.hub",
  "build": {
    "frontendDist": "../web-dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "node scripts/copy-sidecars.mjs && node scripts/siblings.mjs && npm run dev",
    "beforeBuildCommand": "node scripts/copy-sidecars.mjs && node scripts/siblings.mjs && node packaging/windows/generate-context-menu-registry.mjs && node packaging/linux/generate-context-menu-registry.mjs && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "SORAI Toolkit",
        "width": 1060,
        "height": 700,
        "minWidth": 660,
        "minHeight": 460,
        "center": true,
        "visible": false,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$TEMP/sorai-toolkit/thumbnails/*"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMyOTQzRjg5RjgzMzE2NDUKUldSRkZqUDRpVCtVd3QyajZuY21YTjZlSzlQaTgyVVRGMStubEJzYkhnL3A5T2hlZ1NsUFp6L1oK",
      "endpoints": ["https://github.com/chchee3300/sorai-toolkit/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Convert video, image, audio, and PDF files locally",
    "homepage": "https://github.com/chchee3300/sorai-toolkit",
    "externalBin": ["binaries/ffmpeg", "binaries/yt-dlp"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
