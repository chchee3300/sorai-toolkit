{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "bundle": {
    "targets": ["deb", "rpm"],
    "linux": {
      "deb": {
        "depends": ["qpdf", "img2pdf"],
        "provides": ["ffmpeg", "yt-dlp"],
        "conflicts": ["ffmpeg", "yt-dlp"],
        "replaces": ["ffmpeg", "yt-dlp"],
        "files": { "/usr/share/kio/servicemenus": "../packaging/linux/context-menu.generated" }
      },
      "rpm": {
        "depends": ["/usr/bin/qpdf", "/usr/bin/img2pdf"],
        "provides": ["ffmpeg", "yt-dlp"],
        "conflicts": ["ffmpeg", "ffmpeg-free", "yt-dlp"],
        "files": { "/usr/share/kio/servicemenus": "../packaging/linux/context-menu.generated" }
      }
    }
  }
}
